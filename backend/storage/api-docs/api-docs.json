{
    "openapi": "3.0.0",
    "info": {
        "title": "Soccer Note API",
        "description": "サッカーノートアプリケーションのAPI仕様",
        "contact": {
            "email": "admin@example.com"
        },
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8000",
            "description": "開発環境"
        }
    ],
    "paths": {
        "/api/v1/auth/register": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "ユーザー登録",
                "description": "新規ユーザーを登録します",
                "operationId": "register",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RegisterRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "登録成功",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/RegisterResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "バリデーションエラー"
                    }
                }
            }
        },
        "/api/v1/auth/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "ログイン",
                "description": "ユーザーログインしてトークンを発行します",
                "operationId": "login",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/LoginRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "ログイン成功",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/LoginResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "認証失敗"
                    }
                }
            }
        },
        "/api/v1/auth/logout": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "ログアウト",
                "description": "現在のトークンを無効化します",
                "operationId": "logout",
                "responses": {
                    "200": {
                        "description": "ログアウト成功",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/LogoutResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "認証エラー"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/v1/auth/me": {
            "get": {
                "tags": [
                    "Auth"
                ],
                "summary": "認証ユーザー情報取得",
                "description": "現在認証されているユーザーの情報を取得します",
                "operationId": "me",
                "responses": {
                    "200": {
                        "description": "成功",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/GetProfileResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "認証エラー"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/v1/auth/profile": {
            "put": {
                "tags": [
                    "Auth"
                ],
                "summary": "プロフィール更新",
                "description": "認証ユーザーのプロフィール情報を更新します",
                "operationId": "updateProfile",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UpdateProfileRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "更新成功",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UpdateProfileResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "認証エラー"
                    },
                    "422": {
                        "description": "バリデーションエラー"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/v1/auth/password": {
            "put": {
                "tags": [
                    "Auth"
                ],
                "summary": "パスワード変更",
                "description": "認証ユーザーのパスワードを変更します",
                "operationId": "updatePassword",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UpdatePasswordRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "更新成功",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UpdatePasswordResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "認証エラー"
                    },
                    "422": {
                        "description": "バリデーションエラー"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/v1/health": {
            "get": {
                "tags": [
                    "Health"
                ],
                "summary": "ヘルスチェック",
                "description": "APIサーバーの稼働状態を確認します",
                "operationId": "getHealth",
                "responses": {
                    "200": {
                        "description": "正常",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "required": [
                                        "status",
                                        "timestamp"
                                    ],
                                    "properties": {
                                        "status": {
                                            "description": "ステータス",
                                            "type": "string",
                                            "example": "ok"
                                        },
                                        "timestamp": {
                                            "description": "タイムスタンプ",
                                            "type": "string",
                                            "example": "2025-01-10T12:00:00Z"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/notes": {
            "get": {
                "tags": [
                    "Notes"
                ],
                "summary": "ノート一覧取得",
                "description": "ログインユーザーのノート一覧を取得します",
                "operationId": "getNotes",
                "parameters": [
                    {
                        "$ref": "#/components/parameters/page"
                    },
                    {
                        "$ref": "#/components/parameters/per_page"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "取得成功",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/GetNotesResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/401"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Notes"
                ],
                "summary": "ノート作成",
                "description": "新しいノートを作成します",
                "operationId": "createNote",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CreateNoteRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "作成成功",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CreateNoteResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/401"
                    },
                    "422": {
                        "$ref": "#/components/responses/422"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/v1/notes/{id}": {
            "get": {
                "tags": [
                    "Notes"
                ],
                "summary": "ノート詳細取得",
                "description": "指定されたIDのノート詳細を取得します",
                "operationId": "getNote",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ノートID",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "取得成功",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/GetNoteResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/401"
                    },
                    "404": {
                        "$ref": "#/components/responses/404"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "put": {
                "tags": [
                    "Notes"
                ],
                "summary": "ノート更新",
                "description": "指定されたIDのノートを更新します",
                "operationId": "updateNote",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ノートID",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UpdateNoteRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "更新成功",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UpdateNoteResponse"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/401"
                    },
                    "404": {
                        "$ref": "#/components/responses/404"
                    },
                    "422": {
                        "$ref": "#/components/responses/422"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "delete": {
                "tags": [
                    "Notes"
                ],
                "summary": "ノート削除",
                "description": "指定されたIDのノートを削除します",
                "operationId": "deleteNote",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ノートID",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "削除成功"
                    },
                    "401": {
                        "$ref": "#/components/responses/401"
                    },
                    "404": {
                        "$ref": "#/components/responses/404"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        }
    },
    "components": {
        "schemas": {
            "LoginRequest": {
                "required": [
                    "email",
                    "password"
                ],
                "properties": {
                    "email": {
                        "$ref": "#/components/schemas/User/properties/email"
                    },
                    "password": {
                        "type": "string",
                        "format": "password",
                        "example": "password123"
                    },
                    "device_name": {
                        "type": "string",
                        "example": "iPhone 15"
                    }
                },
                "type": "object"
            },
            "RegisterRequest": {
                "required": [
                    "name",
                    "email",
                    "password",
                    "password_confirmation"
                ],
                "properties": {
                    "name": {
                        "$ref": "#/components/schemas/User/properties/name"
                    },
                    "email": {
                        "$ref": "#/components/schemas/User/properties/email"
                    },
                    "password": {
                        "type": "string",
                        "format": "password",
                        "example": "password123"
                    },
                    "password_confirmation": {
                        "type": "string",
                        "format": "password",
                        "example": "password123"
                    }
                },
                "type": "object"
            },
            "UpdatePasswordRequest": {
                "required": [
                    "current_password",
                    "password",
                    "password_confirmation"
                ],
                "properties": {
                    "current_password": {
                        "type": "string",
                        "format": "password",
                        "example": "oldpassword"
                    },
                    "password": {
                        "type": "string",
                        "format": "password",
                        "example": "newpassword123"
                    },
                    "password_confirmation": {
                        "type": "string",
                        "format": "password",
                        "example": "newpassword123"
                    }
                },
                "type": "object"
            },
            "UpdateProfileRequest": {
                "properties": {
                    "name": {
                        "$ref": "#/components/schemas/User/properties/name"
                    },
                    "email": {
                        "$ref": "#/components/schemas/User/properties/email"
                    }
                },
                "type": "object"
            },
            "CreateNoteRequest": {
                "required": [
                    "title",
                    "date",
                    "content"
                ],
                "properties": {
                    "title": {
                        "$ref": "#/components/schemas/Note/properties/title"
                    },
                    "date": {
                        "$ref": "#/components/schemas/Note/properties/date"
                    },
                    "content": {
                        "$ref": "#/components/schemas/Note/properties/content"
                    }
                },
                "type": "object"
            },
            "UpdateNoteRequest": {
                "required": [
                    "title",
                    "date",
                    "content"
                ],
                "properties": {
                    "title": {
                        "$ref": "#/components/schemas/Note/properties/title"
                    },
                    "date": {
                        "$ref": "#/components/schemas/Note/properties/date"
                    },
                    "content": {
                        "$ref": "#/components/schemas/Note/properties/content"
                    }
                },
                "type": "object"
            },
            "Note": {
                "properties": {
                    "id": {
                        "description": "ノートID",
                        "type": "integer",
                        "format": "int64"
                    },
                    "user_id": {
                        "description": "ユーザーID",
                        "type": "integer",
                        "format": "int64"
                    },
                    "title": {
                        "description": "タイトル",
                        "type": "string"
                    },
                    "date": {
                        "description": "日付",
                        "type": "string",
                        "format": "date"
                    },
                    "content": {
                        "description": "内容",
                        "type": "string"
                    },
                    "created_at": {
                        "description": "作成日時",
                        "type": "string",
                        "format": "date-time"
                    },
                    "updated_at": {
                        "description": "更新日時",
                        "type": "string",
                        "format": "date-time"
                    },
                    "deleted_at": {
                        "description": "論理削除日時",
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "User": {
                "properties": {
                    "id": {
                        "description": "ユーザーID",
                        "type": "integer",
                        "format": "int64"
                    },
                    "name": {
                        "description": "ユーザー名",
                        "type": "string"
                    },
                    "email": {
                        "description": "メールアドレス",
                        "type": "string",
                        "format": "email"
                    },
                    "email_verified_at": {
                        "description": "メールアドレス確認日時",
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "password": {
                        "description": "パスワード",
                        "type": "string",
                        "format": "password"
                    },
                    "remember_token": {
                        "description": "リメンバートークン",
                        "type": "string",
                        "nullable": true
                    },
                    "created_at": {
                        "description": "作成日時",
                        "type": "string",
                        "format": "date-time"
                    },
                    "updated_at": {
                        "description": "更新日時",
                        "type": "string",
                        "format": "date-time"
                    },
                    "deleted_at": {
                        "description": "論理削除日時",
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "GetProfileResponse": {
                "properties": {
                    "id": {
                        "$ref": "#/components/schemas/User/properties/id"
                    },
                    "name": {
                        "$ref": "#/components/schemas/User/properties/name"
                    },
                    "email": {
                        "$ref": "#/components/schemas/User/properties/email"
                    },
                    "email_verified_at": {
                        "$ref": "#/components/schemas/User/properties/email_verified_at"
                    },
                    "created_at": {
                        "$ref": "#/components/schemas/User/properties/created_at"
                    },
                    "updated_at": {
                        "$ref": "#/components/schemas/User/properties/updated_at"
                    }
                },
                "type": "object"
            },
            "LoginResponse": {
                "properties": {
                    "token": {
                        "type": "string",
                        "example": "1|abcdefghijklmnopqrstuvwxyz"
                    },
                    "user": {
                        "properties": {
                            "id": {
                                "$ref": "#/components/schemas/User/properties/id"
                            },
                            "name": {
                                "$ref": "#/components/schemas/User/properties/name"
                            },
                            "email": {
                                "$ref": "#/components/schemas/User/properties/email"
                            }
                        },
                        "type": "object"
                    }
                },
                "type": "object"
            },
            "LogoutResponse": {
                "properties": {
                    "message": {
                        "type": "string",
                        "example": "ログアウトしました"
                    }
                },
                "type": "object"
            },
            "RegisterResponse": {
                "properties": {
                    "user": {
                        "properties": {
                            "id": {
                                "$ref": "#/components/schemas/User/properties/id"
                            },
                            "name": {
                                "$ref": "#/components/schemas/User/properties/name"
                            },
                            "email": {
                                "$ref": "#/components/schemas/User/properties/email"
                            },
                            "created_at": {
                                "$ref": "#/components/schemas/User/properties/created_at"
                            }
                        },
                        "type": "object"
                    },
                    "token": {
                        "type": "string",
                        "example": "1|abcdefghijklmnopqrstuvwxyz"
                    }
                },
                "type": "object"
            },
            "UpdatePasswordResponse": {
                "properties": {
                    "message": {
                        "type": "string",
                        "example": "パスワードを更新しました"
                    }
                },
                "type": "object"
            },
            "UpdateProfileResponse": {
                "properties": {
                    "id": {
                        "$ref": "#/components/schemas/User/properties/id"
                    },
                    "name": {
                        "$ref": "#/components/schemas/User/properties/name"
                    },
                    "email": {
                        "$ref": "#/components/schemas/User/properties/email"
                    },
                    "email_verified_at": {
                        "$ref": "#/components/schemas/User/properties/email_verified_at"
                    },
                    "created_at": {
                        "$ref": "#/components/schemas/User/properties/created_at"
                    },
                    "updated_at": {
                        "$ref": "#/components/schemas/User/properties/updated_at"
                    }
                },
                "type": "object"
            },
            "CreateNoteResponse": {
                "properties": {
                    "id": {
                        "$ref": "#/components/schemas/Note/properties/id"
                    },
                    "user_id": {
                        "$ref": "#/components/schemas/Note/properties/user_id"
                    },
                    "title": {
                        "$ref": "#/components/schemas/Note/properties/title"
                    },
                    "date": {
                        "$ref": "#/components/schemas/Note/properties/date"
                    },
                    "content": {
                        "$ref": "#/components/schemas/Note/properties/content"
                    },
                    "created_at": {
                        "$ref": "#/components/schemas/Note/properties/created_at"
                    },
                    "updated_at": {
                        "$ref": "#/components/schemas/Note/properties/updated_at"
                    }
                },
                "type": "object"
            },
            "GetNoteResponse": {
                "properties": {
                    "id": {
                        "$ref": "#/components/schemas/Note/properties/id"
                    },
                    "user_id": {
                        "$ref": "#/components/schemas/Note/properties/user_id"
                    },
                    "title": {
                        "$ref": "#/components/schemas/Note/properties/title"
                    },
                    "date": {
                        "$ref": "#/components/schemas/Note/properties/date"
                    },
                    "content": {
                        "$ref": "#/components/schemas/Note/properties/content"
                    },
                    "created_at": {
                        "$ref": "#/components/schemas/Note/properties/created_at"
                    },
                    "updated_at": {
                        "$ref": "#/components/schemas/Note/properties/updated_at"
                    }
                },
                "type": "object"
            },
            "GetNotesResponse": {
                "properties": {
                    "data": {
                        "type": "array",
                        "items": {
                            "properties": {
                                "id": {
                                    "$ref": "#/components/schemas/Note/properties/id"
                                },
                                "user_id": {
                                    "$ref": "#/components/schemas/Note/properties/user_id"
                                },
                                "title": {
                                    "$ref": "#/components/schemas/Note/properties/title"
                                },
                                "date": {
                                    "$ref": "#/components/schemas/Note/properties/date"
                                },
                                "content": {
                                    "$ref": "#/components/schemas/Note/properties/content"
                                },
                                "created_at": {
                                    "$ref": "#/components/schemas/Note/properties/created_at"
                                },
                                "updated_at": {
                                    "$ref": "#/components/schemas/Note/properties/updated_at"
                                }
                            },
                            "type": "object"
                        }
                    },
                    "current_page": {
                        "type": "integer",
                        "example": 1
                    },
                    "last_page": {
                        "type": "integer",
                        "example": 5
                    },
                    "per_page": {
                        "type": "integer",
                        "example": 15
                    },
                    "total": {
                        "type": "integer",
                        "example": 72
                    }
                },
                "type": "object"
            },
            "UpdateNoteResponse": {
                "properties": {
                    "id": {
                        "$ref": "#/components/schemas/Note/properties/id"
                    },
                    "user_id": {
                        "$ref": "#/components/schemas/Note/properties/user_id"
                    },
                    "title": {
                        "$ref": "#/components/schemas/Note/properties/title"
                    },
                    "date": {
                        "$ref": "#/components/schemas/Note/properties/date"
                    },
                    "content": {
                        "$ref": "#/components/schemas/Note/properties/content"
                    },
                    "created_at": {
                        "$ref": "#/components/schemas/Note/properties/created_at"
                    },
                    "updated_at": {
                        "$ref": "#/components/schemas/Note/properties/updated_at"
                    }
                },
                "type": "object"
            }
        },
        "responses": {
            "401": {
                "description": "認証エラー",
                "content": {
                    "application/json": {
                        "schema": {
                            "properties": {
                                "message": {
                                    "type": "string",
                                    "example": "認証に失敗しました"
                                }
                            },
                            "type": "object"
                        }
                    }
                }
            },
            "404": {
                "description": "リソースが見つかりません",
                "content": {
